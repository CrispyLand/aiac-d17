<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Deliberately NOT a module of the agent's pom, and not sharing its parent by relativePath.
	  The agent app has to be able to run with this project deleted, unbuilt or simply not started
	  — that is the whole point of talking to it over a protocol rather than calling into it. A
	  Maven module would have made "the client handles the server being down" untestable by
	  construction, because the build would refuse to produce one without the other.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.crispyland</groupId>
	<artifactId>mcp-server</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>mcp-server</name>
	<description>A local MCP server exposing three stub tools over SSE.</description>

	<properties>
		<java.version>21</java.version>
		<!--
		  2.0.1 rather than 1.1.x. Spring AI 1.1.8's starters pin spring-boot-starter 3.5.15,
		  a Boot generation below this parent; 2.0.1's pin 4.1.1 exactly. Both ship @McpTool,
		  so the annotation is not what decides it — the Boot version is.
		-->
		<spring-ai.version>2.0.1</spring-ai.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Brings spring-boot-starter-web, the MCP SDK and the @McpTool scanner. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!--
					  The MCP tool schema takes each parameter's NAME from the bytecode. Without
					  this the arguments arrive as arg0/arg1 and the published schema stops
					  describing the tool it belongs to.
					-->
					<parameters>true</parameters>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
